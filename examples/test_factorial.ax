fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

fn main() {
    let result: i64 = factorial(5);
    print(result);

    let x: i64 = 42;
    print(x);

    if x > 10 {
        print("big");
    } else {
        print("small");
    }
}
